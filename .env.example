# 本文件包含敏感信息，已排除在 Git 追踪之外。
# 首次使用请复制 .env.example 为 .env 并填入真实值。
# 运行时自动读取，缺失项会主动询问用户。

# ---- CLS 生产环境（上海） ----
CLS_PROD_TOPIC_ID=
CLS_PROD_LOGSET_ID=
