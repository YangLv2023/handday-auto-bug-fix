# ---- CLS 测试环境（成都） ----
CLS_TEST_TOPIC_ID=
CLS_TEST_LOGSET_ID=
CLS_TEST_REGION=ap-chengdu

# ---- 内部系统地址 ---- 工单/禅道
WORKORDER_BASE_URL=
ZENTAO_BASE_URL=
